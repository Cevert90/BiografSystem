@model CinemaFrontend.Models.MovieViewModel

<h1>Ta bort film</h1>

<p>Är du säker på att du vill ta bort denna film?</p>

<table>
    <tr><td>Titel</td><td>@Model.Title</td></tr>
    <tr><td>Regissör</td><td>@Model.Director</td></tr>
    <tr><td>Genre</td><td>@Model.Genre</td></tr>
    <tr><td>Åldersgräns</td><td>@Model.AgeRating</td></tr>
    <tr><td>Längd</td><td>@Model.DurationMinutes min</td></tr>
</table>

<form method="post">
    @* Hidden field skickar med film-ID:t till controllern vid borttagning. *@
    <input type="hidden" name="id" value="@Model.Id"/>
    <button type="submit">Ja, ta bort</button>
</form>

<a href="/Movies">Avbryt</a>