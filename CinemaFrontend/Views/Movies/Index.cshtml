@model List<CinemaFrontend.Models.MovieViewModel>

<h1>Filmer</h1>

@if (User.Identity.IsAuthenticated)
{
    <a href="/Movies/Create">Lägg till film</a>
}

<h2 style="margin-top: 30px;">Nu på bio</h2> @*Filmkort för aktuella filmer *@
<div style="display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px;">
    @foreach (var movie in Model.Where(m => m.IsShowing))
    {
        <a href="/Movies/Details/@movie.Id" style="text-decoration: none; color: inherit;">
            <div style="width: 270px; border: 1px solid #333; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; cursor: pointer;">
                <img src="@movie.ImageUrl" alt="@movie.Title" style="width: 100%; height: 300px; object-fit: cover;" />
                <div style="padding: 10px; flex: 1; display: flex; flex-direction: column; min-height: 150px;">
                    <h3>@movie.Title</h3>
                    <p>@movie.Genre</p>
                    <p>@movie.DurationMinutes min</p>
                    <div style="margin-top: auto;">
                        <a href="/Screenings/ByMovie/@movie.Id" onclick="event.stopPropagation()">Visningar</a>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span> | <a href="/Movies/Edit/@movie.Id" onclick="event.stopPropagation()">Redigera</a> | <a href="/Movies/Delete/@movie.Id" onclick="event.stopPropagation()">Ta bort</a></span>
                        }
                    </div>
                </div>
            </div>
        </a>
    }
</div>

<h2 style="margin-top: 40px; margin-left: 0;">Kommer snart</h2>
<div style="display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px;">
    @foreach (var movie in Model.Where(m => !m.IsShowing))
    {
        <a href="/Movies/Details/@movie.Id" style="text-decoration: none; color: inherit;">
            <div style="width: 270px; border: 1px solid #333; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; cursor: pointer; opacity: 0.8;">
                <img src="@movie.ImageUrl" alt="@movie.Title" style="width: 100%; height: 300px; object-fit: cover;" />
                <div style="padding: 10px; flex: 1; display: flex; flex-direction: column; min-height: 150px;">
                    <h3>@movie.Title</h3>
                    <p>@movie.Genre</p>
                    <p>Premiär: @movie.Premiere.ToString("yyyy-MM-dd")</p>
                    <div style="margin-top: auto;">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a href="/Movies/Edit/@movie.Id" onclick="event.stopPropagation()">Redigera</a><span> | </span><a href="/Movies/Delete/@movie.Id" onclick="event.stopPropagation()">Ta bort</a> @*Fick konstigt fel vid radbyte, löste det med span.*@

                        }
                    </div>
                </div>
            </div>
        </a>
    }
</div>